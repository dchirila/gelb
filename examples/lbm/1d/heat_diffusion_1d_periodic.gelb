// 1D heat diffusion with periodic BCs (LBM-BGK, D1Q3)
//
// D1Q3 lattice: c = {0, +1, -1}, w = {4/6, 1/6, 1/6}
// Equilibrium (diffusion): feq_i = w_i * T
// Collision (BGK): f_i* = (1-omega)*f_i + omega*feq_i
// Streaming (pull): f_i(x, t+1) = f_i*(x - c_i, t)
//
// Boundary conditions: periodic (domain wraps around)
// Initial condition: delta spike T=2 at center, T=1 elsewhere
// Expected behavior: spike diffuses symmetrically, converges to uniform T
//
// Diffusivity (Krueger et al. 2017, Sec. 8.3.4, Eq. 8.35b):
//   alpha = c_s^2 * (tau - 1/2) = (1/3)*(0.75 - 0.5) ~= 0.0833
// With tau=0.75 this gives omega = 1/tau ~= 1.333.

simulation_description("1D heat diffusion with periodic BCs (LBM-BGK, D1Q3)");

global_constants {
    const int GRID = 32;
    
    // D1Q3 lattice weights
    const array[real, 3] W = {4.0/6.0, 1.0/6.0, 1.0/6.0};
    const array[real, 3] EX = {0.0, 1.0, -1.0};

    // Relaxation: alpha = c_s^2 * (tau - 0.5) = (1/3)(0.25) ~= 0.0833;
    // tau = 0.75, omega = 1/tau ~= 1.333.
    const real tau = 0.75;
    const real omega = 1.0 / tau;
}

lattices {
    lattice f(1, 3, real, GRID, true);
}

// Initialize: T=2 at center (x=16), T=1 elsewhere
// f_i(x,0) = w_i * T(x,0)
initializer InitDelta {
    f.out[x | :] = W * (1 + (x == 16));
}

// Combined collision + streaming (pull scheme)
// Pull: read f_i from upstream neighbor (x - c_i)
// Then collide locally and write to f.out
dynamic CollideAndStream {
    // Stream (pull from upstream neighbors)
    array[real, 3] fIn = upstream_dfs(f, x, EX);
    
    // Macroscopic temperature
    real T = sum(fIn);

    // BGK collision: f_i* = (1 - omega) * f_i + omega * f_i^eq
    // where f_i^eq = w_i * T
    f.out[x | :] = (1.0 - omega) * fIn + omega * W * T;
}

// Output macroscopic temperature
gauge Temperature -> (real temperature) {
    temperature = sum(f.in[x | :]);
}

node_classes {
    node_class BULK(InitDelta, CollideAndStream, Temperature);
}

geometry {
    nodes[:] = BULK;
}
