simulation_description("2D simulation of Taylor-Green vortex problem, using the LBM-BGK method");
global_constants {
  const int SCALING = 32;
  const int N = 32 * SCALING;
  const real NU = 1 / 6.;
  const real TAU_INV = 2 / (6. * NU + 1.);
  const real U_MAX = 0.04 / SCALING;
  const real K = 2 * 3.141592654 / N;
  const real tD = 1 / (2 * NU * K^2); }

lattices { lattice f(2, 9, real); }

geometry {
  set_grid_size({N, N});
  set_grid_periodicity({true, true});
  nodes[:,:] = BULK; }

node_classes { node_class BULK(InitToFEq, BGKCollStream, RhoUV); }

initializer InitToFEq { f.out[x, y | :] = RhoUVToFEq(TaylorGreenRhoUV(x, y, 0)); }

dynamic BGKCollStream {
  array[real, 9] fEq = RhoUVToFEq(DFsToRhoUV(f.in[x, y | :]));
  downstream_dfs(f.out[x, y | :]) = (1 - TAU_INV) * f.in[x, y | :] + TAU_INV * fEq; }

gauge RhoUV(out = {real rho; real U; real V;}) { {rho, U, V} = DFsToRhoUV(f.in[x, y | :]); }

function TaylorGreenRhoUV(in = {int i; int j; int t;}, out = {real rho; real U; real V;}) {
  real X; real Y; X = i + 0.5; Y = j + 0.5;
  rho = 1. - (3/4.) * (U_MAX^2 * (cos(2*K*X) + cos(2*K*Y)) * exp(-2*t/tD));
  U = -U_MAX * cos(K*X) * sin(K*Y) * exp(-t/tD);
  V =  U_MAX * sin(K*X) * cos(K*Y) * exp(-t/tD); }

function DFsToRhoUV(in = {array[real,9] fIn;}, out = {real rho; real U; real V;}) {
  rho = sum(fIn); U = dot_prod(f.E[0,:], fIn); V = dot_prod(f.E[1,:], fIn); }

function RhoUVToFEqi(in = {real rho; real U; real V; int i;}, out = {real fEqi;}) {
  array[real, 2] UV; UV = {U, V};
  fEqi = rho*f.W[i]*(1 + 3*dot_prod(f.E[:,i],UV) + 9/2.*dot_prod(f.E[:,i],UV)^2 - 3/2.*dot_prod(UV,UV)); }

function RhoUVToFEq(in = {real rho; real U; real V;}, out = {array[real,9] fEq;}) {
  fEq = {RhoUVToFEqi(rho, U, V, 0), RhoUVToFEqi(rho, U, V, 1), RhoUVToFEqi(rho, U, V, 2),
         RhoUVToFEqi(rho, U, V, 3), RhoUVToFEqi(rho, U, V, 4), RhoUVToFEqi(rho, U, V, 5),
         RhoUVToFEqi(rho, U, V, 6), RhoUVToFEqi(rho, U, V, 7), RhoUVToFEqi(rho, U, V, 8)}; }

