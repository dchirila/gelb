simulation_description("Test type validation errors");

global_constants {
    const int N = 32;
}

lattices {
    lattice f(2, 9, real, {N, N}, {true, true});
}

initializer TestErrors {
    // This should fail - logical operation on non-bool
    bool b1;
    b1 = 1 && 2;  // ERROR: int && int
    
    f.out[x,y|:] = 0.0;
}

dynamic NoOp {
    f.out[x,y|:] = f.in[x,y|:];
}

gauge TestGauge(out = {real density;}) {
    density = 1.0;
}

node_classes {
    node_class BULK(TestErrors, NoOp, TestGauge);
}

geometry {
    nodes[:,:] = BULK;
}