simulation_name("ex0_int_vec_setto_one");
simulation_description("Pretty much the hello world of GeLB");

lattices {
  lattice f(1,        // d
            1,        // q
            int       // df_type
  );
}

initializer SetDFsToZero { //
  f.out[x | 0] = 0;
}

dynamic SetDFsToOne { //
  f.out[x | 0] = 1;
}

gauge CurrentState(out = {int state;}) { //
  state = f.in[x | 0];
}

node_classes { //
  node_class BULK(SetDFsToZero, SetDFsToOne, CurrentState);
}

geometry { //
  set_grid_size(32);
  set_grid_periodicity(false);
  nodes[:] = BULK;
}
