simulation_description("Pretty much the hello world of GeLB");

lattices {
  lattice f(1,        // d
            1,        // q
            int,      // df_type
            32,       // grid_size
            false     // periodicity
  );
}

initializer SetDFsToZero { //
  f.out[x | 0] = 0;
}

dynamic SetDFsToOne { //
  f.out[x | 0] = 1;
}

gauge CurrentState -> (int state) { //
  state = f.in[x | 0];
}

node_classes { //
  node_class BULK(SetDFsToZero, SetDFsToOne, CurrentState);
}

geometry { //
  nodes[:] = BULK;
}
