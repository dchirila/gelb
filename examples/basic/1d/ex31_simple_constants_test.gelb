simulation_description("Simple test for global constants resolution");

global_constants {
  const int SIZE = 16;
  const int DFS = 3;
}

lattices {
  lattice f(1, DFS, int, SIZE, false);  // DFS should resolve to 3, SIZE to 16
}

initializer Init {
  f.out[x | :] = 0;
}

dynamic Update {
  f.out[x | :] = f.in[x | :] + 1;
}

gauge Output(out = {int val;}) {
  val = f.in[x | 0];
}

node_classes {
  node_class BULK(Init, Update, Output);
}

geometry {
  // Grid size and periodicity are now specified in the lattice declaration
  nodes[:] = BULK;
}