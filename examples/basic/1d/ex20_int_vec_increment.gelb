simulation_name("ex20_int_vec_increment_one");
simulation_description("None");

lattices { //
  lattice f(1, 1, int);
}

initializer SetDFsToZero { //
  f.out[x, y, z | 0] = 0;
}

dynamic IncrementDFs { //
  f.out[x, y, z | 0] = f.in[x | 0] + 1;
}

gauge CurrentState(out = {int state;}) { //
  state = f.in[x, y, z | 0];
}

node_classes { //
  node_class BULK(SetDFsToZero, IncrementDFs, CurrentState);
}

geometry { //
  set_grid_size(32);
  set_grid_periodicity(false);
  nodes[:] = BULK;
}
