simulation_description("None");

lattices { //
  lattice f(1, 1, int, 32, false);
}

initializer SetDFsToZero { //
  f.out[x | 0] = 0;
}

dynamic IncrementDFs { //
  f.out[x | 0] = f.in[x | 0] + 1;
}

gauge CurrentState -> (int state) { //
  state = f.in[x | 0];
}

node_classes { //
  node_class BULK(SetDFsToZero, IncrementDFs, CurrentState);
}

geometry { //
  nodes[:] = BULK;
}
