simulation_description("Test multiple DFs with per-DF access");

lattices {
  lattice f(1, 3, int, 8, false);
}

initializer Init {
  f.out[x | 0] = 10;
  f.out[x | 1] = 20;
  f.out[x | 2] = 30;
}

dynamic SumIntoFirst {
  f.out[x | 0] = f.in[x | 1] + f.in[x | 2];
  f.out[x | 1] = f.in[x | 1];
  f.out[x | 2] = f.in[x | 2];
}

gauge Show -> (int a, int b, int c) {
  a = f.in[x | 0];
  b = f.in[x | 1];
  c = f.in[x | 2];
}

node_classes {
  node_class BULK(Init, SumIntoFirst, Show);
}

geometry {
  nodes[:] = BULK;
}
