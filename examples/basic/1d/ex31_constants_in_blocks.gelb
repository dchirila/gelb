simulation_description("Test symbol resolution from global_constants in various blocks");

global_constants {
  const int N = 64;          // Grid size
  const int Q = 9;           // Number of distribution functions
  const real TAU = 0.6;      // Relaxation time
  const int STEPS = 100;     // Number of simulation steps
}

lattices {
  // Should be able to use Q and N from global_constants
  lattice f(1,        // d (dimensions)
            Q,        // q (number of DFs) - from global_constants!
            real,     // df_type
            N,        // grid_size - from global_constants!
            true      // periodicity
  );
}

initializer SetToEquilibrium {
  // Should be able to use TAU from global_constants
  f.out[x | :] = 1.0 / TAU;  // Simplified equilibrium using TAU
}

dynamic RelaxToEquilibrium {
  // Should be able to use TAU from global_constants
  f.out[x | :] = f.in[x | :] + (1.0 / TAU - f.in[x | :]) / TAU;
}

gauge AverageValue -> (real avg) {
  // For now, just output first DF value
  avg = f.in[x | 0];
}

node_classes {
  node_class BULK(SetToEquilibrium, RelaxToEquilibrium, AverageValue);
}

geometry {
  // Grid size and periodicity are specified in the lattice declaration
  nodes[:] = BULK;
}