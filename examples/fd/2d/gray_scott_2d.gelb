// 2D Gray-Scott reaction-diffusion -- finite-difference scheme in GeLB
//
// Solves the Gray-Scott model (Pearson 1993) on a periodic square grid
// using a standard 5-point Laplacian stencil and explicit-Euler time
// stepping -- no LBM, no equilibrium distributions, just classical
// finite differences expressed directly in GeLB:
//
//     du/dt = Du * laplacian(u) - u v^2 + F (1 - u)
//     dv/dt = Dv * laplacian(v) + u v^2 - (F + k) v
//
// With (F, k) = (0.060, 0.062) an initial square perturbation of the
// trivial steady state u=1, v=0 self-organises into the textbook
// "coral" / mitosis patterns. Other (F, k) give spots, stripes,
// labyrinths, or spatio-temporal chaos.
//
// Two scalar fields are packed into one lattice with q=2:
//   phi[x, y | 0] = u    phi[x, y | 1] = v

simulation_description("2D Gray-Scott reaction-diffusion (finite differences)");

global_constants {
    const int  N    = 256;
    const int  SEED = 20;           // half-width of initial perturbation
    const int  SEED2 = SEED * SEED;
    const real DU   = 0.16;         // diffusion coefficient for u
    const real DV   = 0.08;         // diffusion coefficient for v
    const real FEED = 0.060;        // feed rate
    const real KILL = 0.062;        // kill rate
    const real DT   = 1.0;          // explicit-Euler time step (unit spacing)
}

lattices {
    // DF 0 = u (substrate), DF 1 = v (autocatalyst); periodic on both axes
    lattice phi(2, 2, real, {N, N}, {true, true});
}

initializer SeedPattern {
    // Homogeneous steady state (u=1, v=0) broken by a small disk
    // where u drops to 0.5 and v rises to 0.25, plus a tiny amount of
    // random noise to prevent any latent symmetry from freezing the
    // dynamics on the trivial fixed point.
    int dx = x - N/2;
    int dy = y - N/2;
    int in_seed = ((dx*dx + dy*dy) < SEED2) + 0;
    real noise = 0.02 * (random() - 0.5);

    phi.out[x, y | 0] = 1.0 - 0.5  * in_seed + noise;
    phi.out[x, y | 1] =       0.25 * in_seed + noise;
}

dynamic GrayScottStep {
    // Local values
    real u = phi.in[x, y | 0];
    real v = phi.in[x, y | 1];

    // 5-point Laplacian: sum of axis neighbours minus 4*centre (h = 1).
    // Periodic wrap is handled transparently by the lattice.
    real lap_u = phi.in[x + 1, y    | 0] + phi.in[x - 1, y    | 0]
               + phi.in[x,     y + 1 | 0] + phi.in[x,     y - 1 | 0]
               - 4.0 * u;
    real lap_v = phi.in[x + 1, y    | 1] + phi.in[x - 1, y    | 1]
               + phi.in[x,     y + 1 | 1] + phi.in[x,     y - 1 | 1]
               - 4.0 * v;

    real reaction = u * v * v;

    phi.out[x, y | 0] = u + DT * (DU * lap_u - reaction + FEED * (1.0 - u));
    phi.out[x, y | 1] = v + DT * (DV * lap_v + reaction - (FEED + KILL) * v);
}

gauge Fields -> (real u, real v) {
    u = phi.in[x, y | 0];
    v = phi.in[x, y | 1];
}

node_classes {
    node_class BULK(SeedPattern, GrayScottStep, Fields);
}

geometry {
    nodes[:, :] = BULK;
}
