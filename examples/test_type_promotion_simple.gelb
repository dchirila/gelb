simulation_description("Simple type promotion test");

global_constants {
    const int N = 32;
    const real PI = 3.14159;
}

lattices {
    lattice f(2, 9, real, {N, N}, {true, true});
}

initializer TestPromotion {
    // Test constant definition with promotion
    const real radius = 10;  // int → real
    
    // Test arithmetic with promotion
    real area;
    area = PI * radius * radius;  // all real after promotion
    
    // Test comparison with promotion
    bool big;
    big = area > 100;  // int promoted to real for comparison
    
    f.out[x,y|:] = 0.0;
}

dynamic NoOp {
    f.out[x,y|:] = f.in[x,y|:];
}

gauge TestGauge(out = {real density;}) {
    density = 1.0;
}

node_classes {
    node_class BULK(TestPromotion, NoOp, TestGauge);
}

geometry {
    nodes[:,:] = BULK;
}