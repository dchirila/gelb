// Conway's Game of Life with random initial conditions.
//
// Each cell is randomly set to alive (1) or dead (0) at t=0,
// then evolves under standard Life rules:
//   - A live cell with 2 or 3 neighbors survives.
//   - A dead cell with exactly 3 neighbors is born.
//   - All other cells die (overcrowding or loneliness).
//
// Uses the random() intrinsic to seed the grid.

simulation_description("2D Game of Life — random initial conditions");

global_constants {
    const int GRID = 128;
    const real DENSITY = 0.5;  // initial fraction of live cells
}

lattices {
    lattice f(2, 1, int, {GRID, GRID}, {true, true});
}

initializer RandomLife {
    f.out[x, y | 0] = (random() < DENSITY) + 0;
}

dynamic LifeEvolve {
    int neighborSum;

    neighborSum = f.in[x - 1, y - 1 | 0] + f.in[x - 1, y | 0] +
                  f.in[x - 1, y + 1 | 0] + f.in[x, y - 1 | 0] +
                  f.in[x, y + 1 | 0] + f.in[x + 1, y - 1 | 0] +
                  f.in[x + 1, y | 0] + f.in[x + 1, y + 1 | 0];

    // Conway's rules via integer arithmetic (no if/else needed):
    //   birth:   neighborSum == 3
    //   survive: cell is alive AND neighborSum == 2
    //   new = birth OR survive = birth + survive - birth * survive

    int alive;
    int birth;
    int survive;

    alive = f.in[x, y | 0];
    birth = (neighborSum == 3);
    survive = alive * (neighborSum == 2);
    f.out[x, y | 0] = birth + survive - birth * survive;
}

gauge CellStatus -> (int status) {
    status = f.in[x, y | 0];
}

node_classes {
    node_class BULK(RandomLife, LifeEvolve, CellStatus);
}

geometry {
    nodes[:, :] = BULK;
}
