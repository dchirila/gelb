{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GeLB",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#intrinsic-functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gelb",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gelb",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.gelb",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.gelb",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gelb",
          "match": "\\b(simulation_description|global_constants|lattices|lattice|initializer|dynamic|gauge|node_classes|node_class|geometry|nodes|set_grid_size|set_grid_periodicity)\\b"
        },
        {
          "name": "keyword.other.gelb",
          "match": "\\b(in|out|const)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.gelb",
          "match": "\\b(int|real|bool)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.gelb",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.coordinates.gelb",
          "match": "\\b(x|y|z)\\b"
        }
      ]
    },
    "intrinsic-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.gelb",
          "match": "\\b(sum|dot_prod)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.gelb",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.gelb",
          "match": "\\+|-|\\*|/|%|\\^"
        },
        {
          "name": "keyword.operator.comparison.gelb",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.gelb",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "punctuation.separator.gelb",
          "match": ",|;|\\||:"
        },
        {
          "name": "punctuation.definition.array.gelb",
          "match": "\\[|\\]"
        },
        {
          "name": "punctuation.definition.block.gelb",
          "match": "\\{|\\}"
        },
        {
          "name": "punctuation.definition.parameters.gelb",
          "match": "\\(|\\)"
        },
        {
          "name": "punctuation.accessor.gelb",
          "match": "\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.gelb",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.gelb",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.gelb",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.gelb"
}