        pad="0.9",
        nodesep="0.7",
        ranksep="4.7",
    ];
    node [
        shape=box,
        style=filled,
        fillcolor="#efefef",
        fontname=Helvetica,
        fontsize=26.0,
        fontcolor="#000000",
        height=0.25,
        width=1,
        penwidth=0
    ];
    edge [
        arrowhead=normal,
        arrowsize=3.5,
        len=0.5,
        fontname=Helvetica,
        fontsize=24.0,
        fontcolor="#0000ff",
        color="#bfbfbf"
    ];
    forcelabels=true;

