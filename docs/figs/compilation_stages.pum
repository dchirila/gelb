@startuml
'skinparam title {
'    BorderRoundCorner 15
'    BorderThickness 2
'    BorderColor Gold
'    BackgroundColor Yellow-Gold
'}
'title Compilation stages in GeLB

skinparam Activity {
    FontColor Black
    FontSize 28
}

skinparam Note {
    FontColor Black
    FontSize 24
}

skinparam Legend {
    FontColor Black
    FontSize 24
}

skinparam Partition {
    BorderThickness 1
    BackgroundColor Yellow-Gold
    FontColor Black
    FontSize 20
    'FontStyle bold
}

'legend top left
'|= |= Legend |
'|<back:#00FF00> ***** </back> | Implemented |
'|<back:#FF0000> ***** </back> | Planned for a future release |
'end legend

:GD file (created by the user)/

partition "<back:#FFFFFF>gelbc / FrontEnd</back> " {
    :Load GD file in memory|
    :String<
    :Lexer (lexical analysis)|
    note left
        Generated by ANTLR4
        (from the GD-language grammar)
    end note
    :List of Tokens<
    :Parser (syntax analysis)|
    note left
        Generated by ANTLR4
        (from the GD-language grammar)
    end note
    :Parse Tree<
    :Type Checker|
    :Parse-Tree Visitor|
    note right
        Generated by ANTLR4 and
        Extended (s.t. it generates the AST upon tree traversal)
    end note
    :Abstract Syntax Tree (AST)<
}

:Abstract Syntax Tree (AST)<

partition "<back:#FFFFFF>gelbc / MidWare</back> " {
    :AST transformations (optimization);
}

:AST (simplified & optimized)<

    split
        partition "<back:#FFFFFF>gelbc / BackEnd / CPU-Serial-C</back> " {
            :BackEnd AST-Optimizer (CPU-Serial-C)|
            :AST (backend-optimized)<
            :Code-Generator (CPU-Serial-C)|
        }
        :C file/
        :C compiler|
        :binary file/
        :execute (on single-core)|
        detach
'    split again
'        partition "<back:#FFFFFF>gelbc / BackEnd / CPU-Parallel-C-OpenMP</back> " {
'            :BackEnd AST-Optimizer (CPU-Parallel-C-OpenMP)|
'            :AST (backend-optimized)<
'            :Code-Generator (CPU-Parallel-C-OpenMP)|
'        }
'        :C file (with OpenMP pragmas)/
'        :C compiler (with OpenMP support)|
'        :binary file/
'        :execute (on multi-core machine)|
'        note left
'            OpenMP library
'        end note
'        detach
    split again
        partition "<back:#FFFFFF>gelbc / BackEnd / GPU-Parallel-C-OpenCL</back> " {
            :BackEnd AST-Optimizer (GPU-Parallel-C-OpenCL)|
            :AST (backend-optimized)<
            :Code-Generator (GPU-Parallel-C-OpenCL)|
        }
        split
            :C file (host code)/
            :C compiler|
            :binary file/
        split again
            :OpenCL kernel/
        end split
        :execute (on GPU-equipped machine)|
        note left
            OpenCL library
            (with kernel compiler)
        end note
        detach
    end split
@enduml
