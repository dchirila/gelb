@startuml
'https://plantuml.com/class-diagram

title <font size=25>Inheritance diagram for AST-Node classes in GeLB-v0 (pre-release)</font>

left to right direction
skinparam groupInheritance 3
skinparam DefaultFontSize 20
skinparam classFontSize 22
' skinparam linetype polyline

' AST node classes
abstract class Node_N {
    + code_range

    + __init__(self, code_range)
    + __str__(self)
    ' + eval(self)
}

class Stmt_N {
}

class Expr_N {
}

class SetSimulationNameStmt_N #palegreen;line:green;text:black {
    + name

    + __init__(self, code_range, name)
    + __str__(self)
}

class SetSimulationDescriptionStmt_N #palegreen;line:green;text:black {
    + description

    + __init__(self, code_range, description)
    + __str__(self)
}

class List_N #palegreen;line:green;text:black {
    + elements

    + __init__(self, code_range)
    + append(self, element)
    + __getitem__(self, i)
    + __len__(self)
    + __str__(self)
}

class Program_N #palegreen;line:green;text:black {
    + simulation_name
    + simulation_description
    + global_constants
    + lattice_constants_blocks
    + lattices
    + initializers
    + dynamics
    + gauges
    + node_classes
    + geometry

    + __init__(self, code_range)
    + __str__(self)
}

class Block_N {
    + stmts

    + __init__(self, code_range, stmts)
}

class GlobalConstantsBlock_N #palegreen;line:green;text:black {
    + __str__(self)
}

class LatticeConstantsBlock_N #palegreen;line:green;text:black {
    + name

    + __init__(self, code_range, name, stmts)
    + __str__(self)
}

class LatticesBlock_N #palegreen;line:green;text:black {
    + __str__(self)
}

class LatticeInstaStmt_N #palegreen;line:green;text:black {
    + name
    + d
    + q
    + df_type
    + size

    + __init__(self, code_range, name, d, q, df_type, size)
    + __str__(self)
}

class NodeClassesBlock_N #palegreen;line:green;text:black {
    + __str__(self)
}

class NodeClassInstaStmt_N #palegreen;line:green;text:black {
    + name
    + initializer
    + dynamic
    + gauge

    + __init__(self, code_range, name, initializer, dynamic, gauge)
    + __str__(self)
}

class InitializerBlock_N #palegreen;line:green;text:black {
    + name

    + __init__(self, code_range, name, stmts)
    + __str__(self)
}

class DynamicBlock_N #palegreen;line:green;text:black {
    + name

    + __init__(self, code_range, name, stmts)
    + __str__(self)
}

class GaugeBlock_N #palegreen;line:green;text:black {
    + name
    + outputs

    + __init__(self, code_range, name, outputs, stmts)
    + __str__(self)
}

class GeometryBlock_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Identifier_N #palegreen;line:green;text:black {
    + name

    + __init__(self, code_range, name)
    + __str__(self)
}

class Range_N #palegreen;line:green;text:black {
    + low
    + high

    + __init__(self, code_range, low, high)
    + __str__(self)
}

class RectSel_N {
    + element_ranges

    + __init__(self, code_range, element_ranges)
}

class RectSelOfLatticeDFs_N {
    + lattice_name

    + __init__(self, code_range, lattice_name, element_ranges)
}

class RectSelOfLatticeInDFs_N #palegreen;line:green;text:black {
    + __str__(self)
}

class RectSelOfLatticeOutDFs_N #palegreen;line:green;text:black {
    + __str__(self)
}

class RectSelOfArrayElems_N #palegreen;line:green;text:black {
    + array_name

    + __init__(self, code_range, array_name, element_ranges)
    + __str__(self)
}

class DataType_N {
    + scalar_dtype

    + __init__(self, code_range, scalar_dtype)
}

class ScalarDataType_N #palegreen;line:green;text:black {
    + __str__(self)
}

class ArrayDataType_N #palegreen;line:green;text:black {
    + shape

    + __init__(self, code_range, scalar_dtype, shape)
    + __str__(self)
}

class BinaryExpr_N {
    + left
    + right

    + __init__(self, code_range, left, right)
}

class Mul_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Div_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Add_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Sub_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Pow_N #palegreen;line:green;text:black {
    + __str__(self)
}

class UnaryExpr_N {
    + value

    + __init__(self, code_range, value)
}

class NotExpr_N #palegreen;line:green;text:black {
    + __str__(self)
}

class UnaryMinusExpr_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Literal_N {
    + value

    + __init__(self, code_range, value)
}

class IntLiteral_N #palegreen;line:green;text:black {
    + __str__(self)
}

class RealLiteral_N #palegreen;line:green;text:black {
    + __str__(self)
}

class BoolLiteral_N #palegreen;line:green;text:black {
    + __str__(self)
}

class StringLiteral_N #palegreen;line:green;text:black {
    + __str__(self)
}

class ArrayLiteral_N {
}

class Array1DLiteral_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Array2DLiteral_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Array3DLiteral_N #palegreen;line:green;text:black {
    + __str__(self)
}

class Array4DLiteral_N #palegreen;line:green;text:black {
    + __str__(self)
}

' class FunctionCall_N {
' }

class ConstantDefinitionStmt_N #palegreen;line:green;text:black {
    + data_type
    + name
    + value

    + __init__(self, code_range, data_type, name, value)
    + __str__(self)
}

class VariableDeclarationStmt_N #palegreen;line:green;text:black {
    + data_type
    + name

    + __init__(self, code_range, data_type, name)
    + __str__(self)
}

class AssignmentStmt_N {
    + lhs
    + rhs

    + __init__(self, code_range, lhs, rhs)
}

class PaintNodesStmt_N #palegreen;line:green;text:black {
    + __str__(self)
}

class VariableAssignmentStmt_N #palegreen;line:green;text:black {
    + __str__(self)
}

class LatticeAssignmentStmt_N #palegreen;line:green;text:black {
    + __str__(self)
}

' Relationships
Node_N <|-- List_N
Node_N <|-- Program_N
Node_N <|-- Block_N
Block_N <|-- GlobalConstantsBlock_N
Block_N <|-- LatticeConstantsBlock_N
Block_N <|-- LatticesBlock_N
