UnaryExpr_N <|-- UnaryMinusExpr_N
Expr_N <|-- Literal_N
Literal_N <|-- IntLiteral_N
Literal_N <|-- RealLiteral_N
Literal_N <|-- BoolLiteral_N
Literal_N <|-- StringLiteral_N
Literal_N <|-- ArrayLiteral_N
ArrayLiteral_N <|-- Array1DLiteral_N
ArrayLiteral_N <|-- Array2DLiteral_N
ArrayLiteral_N <|-- Array3DLiteral_N
ArrayLiteral_N <|-- Array4DLiteral_N
' Node_N <|-- FunctionCall_N
Node_N <|-- Stmt_N
Stmt_N <|-- ConstantDefinitionStmt_N
