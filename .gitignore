# contains data which allows to run the built-in interpreter, instead of the
# generated parser (mostly useful for debugging the grammar)
#
gelb/antlr4/generated_code/GeLB.interp
gelb/antlr4/generated_code/GeLBLexer.interp
#
# contains ANTLR4-related files which were auto-generated by a VSCode plugin
#
gelb/antlr4/grammars/.antlr/*
