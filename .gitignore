.idea/
/.vscode/

# Ignore all __pycache__ directories
**/__pycache__/

# Ignore venv directory
.venv/

# Python package build artifacts
*.egg-info/
dist/
build/

# Auto-generated HTML files from RST
**/*.rst.html
*.html

# ANTLR generated files (Python modules are committed so the package
# is installable without a JDK; .interp/.tokens are tooling artefacts
# that add no value to end users).
gelb/antlr_part/generated_code/*.interp
gelb/antlr_part/generated_code/*.tokens

# Fortran build artifacts
# .mod = Fortran module interface (compiler-generated; analogous to .h
#        files in C).
*.mod
*.o

# Simulation output (NetCDF) and sweep result directories
*.nc
rb_sweep_results_*/
rb_2d/
rb_3d/
# scripts/validate_analytical.py writes its plot into the CWD by default
validation_convergence.png

# Claude Code workspace state
.claude/

# Imported PhD thesis reference sources (external, not part of gelb)
results_for_phd_thesis__Nov_2017/

# Other reference PDFs (books I bought, etc.)
refs/

# Local builds of the manual PDFs. The release copies are committed
# under docs/pdf/.
/GeLB_User_Tutorial.pdf
/GeLB_Developer_Manual.pdf
.DS_Store

# VSCode extension build artifacts
vscode-gelb/node_modules/
vscode-gelb/out/
vscode-gelb/*.vsix

# Docusaurus source for gelb-lang.org — lives in its own repo
# (dropped here as a working copy; never meant to be committed into gelb/)
gelb_site/

# Asymptote intermediate output. The .asy sources + rendered .pdf
# / .svg are tracked; the .eps (and gs's tmp files) are regenerated
# from the source on every scripts/render_figs.sh run.
docs/figs/*.eps

# Sphinx build output. `make html` in docs/ writes here; the content
# is derived from the .rst sources, so there's no reason to track it.
docs/_build/

# Machine notes (private, not to be committed)
.machine_notes/

# AST visualisation outputs are generated on demand (see docs/visualizations/README.md)
docs/visualizations/*
!docs/visualizations/README.md
