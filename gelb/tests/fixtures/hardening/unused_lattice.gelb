// Hardening test: lattice 'g' is declared but never used in any block.
// The compiler should warn or error about the unused lattice.

simulation_description("Unused lattice declaration");

lattices {
  lattice f(1, 2, int, 4, false);
  lattice g(1, 3, int, 4, false);   // unused -- no block reads or writes g
}

initializer Init {
  f.out[x | :] = 0;
}

dynamic Step {
  f.out[x | :] = f.in[x | :] + 1;
}

gauge Report -> (int total) {
  total = f.in[x | 0] + f.in[x | 1];
}

node_classes {
  node_class BULK(Init, Step, Report);
}

geometry {
  nodes[:] = BULK;
}
