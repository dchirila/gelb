simulation_description("Tutorial diagnostic");
lattices { lattice f(1, 3, real, 16, false); }

initializer Init {
    f.out[x | :] = 0.5;
}
dynamic Collide {
    f.in[x | 0] = 1.0;
}
gauge G -> (real v) { v = sum(f.in[x | :]); }
node_classes { node_class BULK(Init, Collide, G); }
geometry { nodes[:] = BULK; }
