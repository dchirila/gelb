simulation_description("Masked DF zero probe");
lattices { lattice f(1, 3, real, 8, true); }
initializer I { f.out[x | :] = 1.0; }
initializer MInit { f.out[x | 0] = 7.0; }
dynamic D { f.out[x | :] = f.in[x | :]; }
dynamic MDyn { f.out[x | 0] = 7.0; f.out[x | 1] = 9.0; }
gauge G -> (real a, real b, real c) {
    a = f.in[x + 1 | 0];
    b = f.in[x + 1 | 1];
    c = f.in[x + 1 | 2];
}
node_classes {
    node_class B(I, D, G);
    node_class M(MInit, MDyn) masked;
}
geometry {
    nodes[:] = B;
    nodes[3] = M;
}
