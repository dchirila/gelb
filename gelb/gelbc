#!/usr/bin/env python3

# BEGIN :: PYTHONPATH check #
# NOTE: without PYTHONPATH set, we cannot import code from other parts of
#       GeLB, which makes this code not-so-elegant.
import click
from colorama import Fore, Style
import sys
from os import environ
try:
    PYTHONPATH = environ['PYTHONPATH']
except:
    # display the error message
    click.echo(Fore.RED + "gelbc-ERROR:" + Style.RESET_ALL, nl=False)
    click.echo(f" PYTHONPATH env var not set\n")
    # say that it was a fatal error
    click.echo(Fore.RED + "gelbc-ERROR:" + Style.RESET_ALL, nl=False)
    click.echo(" aborting compilation due to previous error\n")
    # display a hint
    click.echo(Fore.GREEN + "gelbc-HINT:" + Style.RESET_ALL, nl=False)
    click.echo(
        " This is a development version of gelbc, which requires you to add the"
        " root directory of the repository to the PYTHONPATH environment"
        " variable.\n\nFor example, I cloned the repo into the directory:\n\n"
        "\"/home/dchirila/MyRepos/gelb\"\n\nso I added the line:\n\n"
        "export PYTHONPATH=\"${PYTHONPATH}:/home/dchirila/MyRepos/gelb\"\n\n"
        "to my ~/.zshrc file (also works with ~/.bashrc, if you use Bash)."
    )
    sys.exit(1)
# END :: PYTHONPATH check #

# If we reached this point, we should be able to import GeLB modules
from gelb.utils.misc import load_file
from gelb.stage1_frontend import get_ast


@click.command()
@click.option(
    "-v",
    is_flag=True,
    help="Make the compiler more verbose (useful for debugging)"
)
@click.argument(
    "input_file",
    # not using click.Path(), s.t. we can show nicer error-message
    type=click.STRING,
    nargs=1
)
@click.option(
    "--backend",
    type=click.Choice(
        ['cpu_c_serial',
         'cpu_c_parallel_openmp',
         'gpu_c_parallel_opencl',
         ]
    ),
    default='cpu_c_serial',
    help="Which backend to use for code-generation"
)
def cli(v, input_file, backend):
    """
gelbc -- reference compiler (actually: "transpiler") for the GeLB DSL.

This is the compiler-driver, which reads a "*.gelb" file and passes it
through the various stages of the compiler.
    """
    # Stage 1 :: FrontEnd
    src_raw = load_file(input_file, v)
    # TODO add support for verbose flag
    # ast = get_ast("gelb_program", src_raw, v)
    ast = get_ast("gelb_program", src_raw, v)
    print(ast)
    # ... TODO semantic analysis, checks, etc.

