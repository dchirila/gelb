#!/usr/bin/env python3

"""
gelbc -- reference compiler (more accurately: "transpiler") for the GeLB DSL.

This is the compiler-driver, which reads a "*.gelb" file and passes it through
the various stages of the compiler.
"""

# BEGIN :: PYTHONPATH check #
# NOTE: without PYTHONPATH set, we cannot import code from other parts of
#       GeLB, which makes this code not-so-elegant.
from click import echo
from colorama import Fore, Style
import sys
from os import environ
try:
    PYTHONPATH = environ['PYTHONPATH']
except:
    # display the error message
    echo(Fore.RED + "<<<gelbc-ERROR>>>" + Style.RESET_ALL, nl=False)
    echo(f" PYTHONPATH env var not set")
    # say that it was a fatal error
    echo(Fore.RED + "<<<gelbc-ERROR>>>" + Style.RESET_ALL, nl=False)
    echo(" aborting due to previous error")
    # display a hint
    echo(Fore.GREEN + "<<<gelbc-HINT >>>" + Style.RESET_ALL, nl=False)
    echo("""
This is a development version of gelbc, which requires you to add the
root directory of the repository to the PYTHONPATH environment variable.

For example, I cloned the repo into the directory:

"/home/dchirila/Desktop/mySWProjects/Work/gelb"

so I added the line:

export PYTHONPATH="${PYTHONPATH}:/home/dchirila/Desktop/mySWProjects/Work/gelb"

to my ~/.zshrc file (also works with ~/.bashrc, if you use the Bash shell).
    """)
    sys.exit(1)
# END :: PYTHONPATH check #

# If we reached this point, we should be able to import GeLB modules
from gelb.utils.misc import load_file
from gelb.stage1_frontend import get_ast

import argparse as argp


if __name__ == '__main__':
    p = argp.ArgumentParser(description=__doc__, prog='gelbc')
    p.add_argument(
        "input_file",
        help="input_file (\".gelb\")",
        default=None
    )
    p.add_argument(
        "-b",
        "--backend",
        help="generate code using BACKEND",
        default=None
    )
    p.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="make the compiler more verbose (useful for debugging)"
    )
    args = p.parse_args()

    # Stage 1 :: FrontEnd
    src_raw = load_file(args.input_file, args.verbose)
    # TODO add support for verbose flag
    # ast = get_ast("gelb_program", src_raw, args.verbose)
    ast = get_ast("gelb_program", src_raw)
    print(ast)
    # ... TODO semantic analysis, checks, etc.

    # Stage 2 :: MidWare
    # ... TODO More checks & AST transformations

    # Stage 3 :: BackEnd
    # ... TODO code-generation