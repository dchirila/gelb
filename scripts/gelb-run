#!/usr/bin/env bash
#
# gelb-run -- compile and run a GeLB program in one step.
#
# The script itself lives in the Python package, gelb/scripts/gelb-run,
# so that the installed command ``gelb-run`` (next to ``gelbc`` and
# ``gelb-view``) carries it.  This shim keeps the historical path
# working: the macOS bundle's bin/gelb-run wrapper and the test suite
# call scripts/gelb-run.
exec "$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/gelb/scripts/gelb-run" "$@"
